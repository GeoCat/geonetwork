pipeline {
    agent any
    options {
        // The buildpack cache is per branch (see Docker Build), so two builds
        // of the same branch must not share it at the same time.
        disableConcurrentBuilds()
    }
    tools {
        jdk 'jdk-21'
    }
    environment {
        REGISTRY = 'docker-registry.geocat.net:5000'
        SAFE_BRANCH = "${env.BRANCH_NAME.replaceAll('/', '_')}"
        DOCKER_IMAGE_COMMIT = "${env.REGISTRY}/geocatlive/gn5:${env.SAFE_BRANCH}-${env.GIT_COMMIT[0..7]}"
        DOCKER_IMAGE_BRANCH = "${env.REGISTRY}/geocatlive/gn5:${env.SAFE_BRANCH}"

    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh './mvnw -B clean install -Drelax'
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    // Build under the branch tag: the buildpack cache volumes are
                    // named after the image, so a per-commit name left a new pair
                    // of pack-cache-* volumes behind on every build.
                    sh "./mvnw -B -f src/apps/geonetwork/pom.xml spring-boot:build-image -DskipTests -Dspring-boot.build-image.imageName=${DOCKER_IMAGE_BRANCH}"
                }
            }
        }
        stage('Docker Push') {
            when {
                expression { env.BRANCH_NAME != null && env.GIT_COMMIT != null }
            }
            steps {
                script {
                    docker.withRegistry("https://${env.REGISTRY}", 'docker-registry-credentials') {
                        def newImage = docker.image("${env.DOCKER_IMAGE_BRANCH}")
                        newImage.push()
                        newImage.push("${env.SAFE_BRANCH}-${env.GIT_COMMIT[0..7]}")
                    }
                }
            }
        }
        stage('Clean Up Docker Images') {
            when {
                expression { env.BRANCH_NAME != null && env.GIT_COMMIT != null }
            }
            steps {
                script {
                    sh "docker rmi ${env.DOCKER_IMAGE_COMMIT} || true"
                    sh "docker rmi ${env.DOCKER_IMAGE_BRANCH} || true"
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
